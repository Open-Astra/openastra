#cloud-config

package_update: true
package_upgrade: true

packages:
  - docker.io
  - docker-compose-v2
  - git
  - ufw
  - fail2ban
  - unattended-upgrades

write_files:
  - path: /etc/ufw/applications.d/astra
    content: |
      [Astra]
      title=Astra Gateway
      description=Astra AI Agent Platform
      ports=8080/tcp

  - path: /opt/astra/.env
    permissions: "0600"
    content: |
      NODE_ENV=production
      PORT=8080
      PG_HOST=${db_host}
      PG_PORT=${db_port}
      PG_USER=${db_user}
      PG_PASSWORD=${db_password}
      PG_DATABASE=${db_name}
      PG_SSL=true
      PG_SSLMODE=${db_sslmode}
      TYPESENSE_HOST=typesense
      TYPESENSE_PORT=8108
      TYPESENSE_PROTOCOL=http
      TYPESENSE_API_KEY=${typesense_api_key}
      JWT_SECRET=${jwt_secret}
      INTERNAL_API_KEY=${internal_api_key}
      LLM_API_KEY=${llm_api_key}
      EMBEDDING_PROVIDER=local

  - path: /opt/astra/docker-compose.yml
    content: |
      services:
        typesense:
          image: typesense/typesense:27.1
          container_name: typesense
          restart: always
          # API key comes from the TYPESENSE_API_KEY env var (env_file), so it
          # is not visible in the process list or `docker inspect` args.
          command: --data-dir /data --enable-cors
          env_file: .env
          ports:
            - "127.0.0.1:8108:8108"
          volumes:
            - /mnt/${volume_name}:/data
          healthcheck:
            # The Typesense image ships no curl — plain TCP check via bash.
            test: ["CMD-SHELL", "bash -c '</dev/tcp/localhost/8108' 2>/dev/null"]
            interval: 15s
            timeout: 5s
            retries: 3
            start_period: 10s

        gateway:
          image: ${gateway_image}
          container_name: gateway
          restart: always
          env_file: .env
          ports:
            - "8080:8080"
          # astra.yml, prompts/ and SOUL.md are baked into the image. To
          # override, place a file at /opt/astra/astra.yml and add:
          #   volumes: ["./astra.yml:/app/astra.yml:ro"]
          depends_on:
            typesense:
              condition: service_healthy
          healthcheck:
            # node:20-slim ships no curl — probe with node itself.
            test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:8080/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
            interval: 30s
            timeout: 5s
            retries: 3
            start_period: 30s
          read_only: true
          tmpfs:
            - /tmp:size=128m
          security_opt:
            - no-new-privileges:true
          cap_drop:
            - ALL
          deploy:
            resources:
              limits:
                memory: 1g
                cpus: "2.0"

  - path: /etc/systemd/system/astra.service
    content: |
      [Unit]
      Description=Astra AI Agent Platform
      Requires=docker.service
      After=docker.service

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      WorkingDirectory=/opt/astra
      ExecStart=/usr/bin/docker compose up -d
      ExecStop=/usr/bin/docker compose down
      TimeoutStartSec=120

      [Install]
      WantedBy=multi-user.target

runcmd:
  - systemctl enable docker
  - systemctl start docker
  - ufw default deny incoming
  - ufw default allow outgoing
  # Source-address filtering is enforced by the DigitalOcean cloud firewall
  # (firewall.tf). Docker-published ports bypass ufw, so Typesense is bound
  # to 127.0.0.1 above and only :8080 is published.
  - ufw allow 22/tcp
  - ufw allow 8080/tcp
  - ufw --force enable
  - systemctl enable fail2ban
  - systemctl start fail2ban
  - docker pull typesense/typesense:27.1
  - docker pull ${gateway_image}
  - systemctl enable astra
  - systemctl start astra
