{
  "name": "astra-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "astra": "./astra.mjs"
  },
  "scripts": {
    "dev": "tsx watch --env-file .env src/gateway/index.ts",
    "build": "tsc && node -e \"const fs=require('fs');fs.cpSync('src/db/migrations','dist/db/migrations',{recursive:true});fs.cpSync('src/data/migrations','dist/data/migrations',{recursive:true})\"",
    "start": "node dist/gateway/index.js",
    "typecheck": "tsc --noEmit",
    "test:coverage:raw": "vitest run --coverage",
    "test:coverage": "npm run test:coverage:raw && node scripts/check-critical-coverage.mjs",
    "ci": "npm run typecheck && npm run test:coverage && npm run build",
    "cli": "tsx --env-file .env src/standalone/cli.ts",
    "cli:dev": "tsx watch --env-file .env src/standalone/cli.ts",
    "setup": "tsx src/standalone/setup.ts",
    "costs": "tsx src/standalone/costs.ts",
    "doctor": "tsx src/standalone/doctor.ts",
    "trigger": "tsx --env-file .env src/standalone/trigger-agent.ts",
    "astra": "tsx src/bin/astra.ts",
    "astra:dev": "tsx watch src/bin/astra.ts",
    "secrets:encrypt": "sops --encrypt --age $(cat .age-recipients) .env > .env.enc",
    "secrets:decrypt": "sops --decrypt .env.enc > .env",
    "secrets:edit": "sops .env.enc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@aws-sdk/client-bedrock-runtime": "^3.997.0",
    "@google-analytics/data": "^5.2.2",
    "@google/genai": "^1.45.0",
    "@google/generative-ai": "^0.24.1",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/bcrypt": "^6.0.0",
    "@types/pdf-parse": "^1.1.5",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "googleapis": "^171.4.0",
    "jose": "^6.1.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.1",
    "openai": "^6.22.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.18.0",
    "typesense": "^3.0.1",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.16.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
