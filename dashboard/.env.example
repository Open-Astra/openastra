# Gateway REST base URL.
# Default "/api" is a same-origin prefix that your reverse proxy (or the Vite
# dev proxy) strips before forwarding to the gateway, whose routes live at the
# root (/auth, /agents, ...). To call the gateway directly, set its origin:
# VITE_API_URL=https://astra.example.com
VITE_API_URL=/api

# Gateway WebSocket URL. Default: ws(s)://<page host>/ws (wss on HTTPS pages).
# VITE_WS_URL=wss://astra.example.com/ws

# Show sample data in a production build (adds a visible "Demo mode" banner).
# Leave unset for real deployments.
# VITE_DEMO_MODE=true
